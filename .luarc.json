{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.3",
    "path": [
      "src/?.lua",
      "src/?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "src/lib/blizzard"
    ],
    "ignoreDir": [
      "src/lib/community/types/assets/main-debug.lua",
      "src/lib/community/types/assets/main-release.lua"
    ],
    "preloadFileSize": 1024
  },
  "diagnostics": {
    "disable": [
      "empty-block"
    ],
    "globals": [
      "Timed",
      "Debug",
      "ENUM_WAIT",
      "Hook",
      "UnitEvent",
      "seterrorhandler",
      "args",
      "sourcecode"
    ]
  }
}
