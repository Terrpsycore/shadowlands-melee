{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "Lua 5.3",
    "path": [
      "src/?.lua",
      "src/?/init.lua",
      "src/vendor/assets/objediting/?.lua",
      "src/vendor/assets/objediting/?/init.lua"
    ]
  },
  "workspace": {
    "library": [
      "src/vendor/blizzard"
    ],
    "useGitIgnore": false,
    "ignoreDir": [
      "src/vendor/assets/main-debug.lua",
      "src/vendor/assets/main-release.lua",
      "map.w3x",
      ".build",
      ".def",
      "tmp"
    ],
    "preloadFileSize": 1024
  },
  "diagnostics": {
    "disable": [
      "empty-block",
            "unused-local",
            "undefined-field",
            "redefined-local"
      //"undefined-field"
    ],
    "globals": [
      "Timed",
      "Debug",
      "ENUM_WAIT",
      "Hook",
      "UnitEvent",
      "seterrorhandler",
      "args",
      "sourcecode",
      "dump"
    ]
  }
}